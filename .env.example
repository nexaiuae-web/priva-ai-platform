# ============================================
# PRIVA-AI — Environment Configuration
# ============================================

# Master key for admin operations
MASTER_KEY=your_master_key_here

# Chat — OpenAI cloud (fast streaming)
CHAT_PROVIDER=openai
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-your-openai-key-here

# Groq Llama-3.3-70B — automatic failover when OpenAI times out / rate-limits /
# 5xx. Set the real key in Render environment variables (never commit secrets).
GROQ_API_KEY=your-groq-api-key-here
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# Ollama — fallback when CHAT_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_CHAT_MODEL=qwen2.5:1.5b

# Embeddings — local nomic-embed-text (768 dims)
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBED_MODEL=nomic-embed-text
CHROMA_EMBED_DIM=768

# Optional: OpenAI embeddings (separate from chat)
# EMBEDDING_PROVIDER=openai
# OPENAI_EMBED_MODEL=text-embedding-3-small

# MongoDB
MONGODB_URI=mongodb://localhost:27017/priva_ai_db
TENANT_STORE=mongo

# Cloudinary — optional document/file storage
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Brevo — Email OTP authentication (REST API, bypasses blocked SMTP ports on Render)
# If BREVO_API_KEY is not set, OTP codes are logged to the console (mock mode).
BREVO_API_KEY=

# FaceID — on-device face-api / TF.js
FACE_DISTANCE_THRESHOLD=0.65
FACE_DETECTION_MIN_CONFIDENCE=0.40
FACE_ADAPTATION_DISTANCE_MIN=0.52
FACE_ADAPTATION_DISTANCE_MAX=0.62

# RAG context budget
CHAT_PARENT_EXCERPT_CHARS=2500
CHAT_CHILD_EXCERPT_CHARS=4000
CHAT_MAX_CONTEXT_CHARS=300000
CHAT_MAX_CONTEXT_TOKENS=85000
CHAT_MAX_PAYLOAD_TOKENS=120000
CHAT_MAX_COMPLETION_TOKENS=2048
CHAT_MAX_CHUNKS=12
CHAT_HISTORY_MAX_MESSAGES=6
CHAT_TOP_K=8
CHAT_FETCH_N=50

# Login protection — CAPTCHA after 3 failed attempts
# TURNSTILE_SECRET_KEY=
# RECAPTCHA_SECRET_KEY=
# RECAPTCHA_MIN_SCORE=0.5
# CAPTCHA_DEV_BYPASS=true
